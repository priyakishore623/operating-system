#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <string.h>

int main()
{
    int fd;
    char writeData[] = "Hello! This is UNIX file management.";
    char readData[100];
    int bytes;

    /* Create and open the file */
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if (fd == -1)
    {
        printf("Error opening file.\n");
        return 1;
    }

    printf("File opened successfully.\n");

    /* Write data to the file */
    bytes = write(fd, writeData, strlen(writeData));

    if (bytes == -1)
    {
        printf("Error writing to file.\n");
        close(fd);
        return 1;
    }

    printf("Data written successfully.\n");

    /* Move file pointer to beginning */
    lseek(fd, 0, SEEK_SET);

    /* Read data from the file */
    bytes = read(fd, readData, sizeof(readData) - 1);

    if (bytes == -1)
    {
        printf("Error reading file.\n");
        close(fd);
        return 1;
    }

    readData[bytes] = '\0';

    printf("Data read from file: %s\n", readData);

    /* Close the file */
    close(fd);

    printf("File closed successfully.\n");

    return 0;
}
