
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main() {
    int id;
    char *data;
    pid_t pid;

    id = shmget(IPC_PRIVATE, 100, IPC_CREAT | 0666);
    if (id == -1) {
        perror("shmget");
        return 1;
    }

    data = (char *)shmat(id, NULL, 0);
    if (data == (char *)-1) {
        perror("shmat");
        shmctl(id, IPC_RMID, NULL);
        return 1;
    }

    pid = fork();

    if (pid == 0) {
        snprintf(data, 100, "Hello from child process");
        shmdt(data);
        exit(0);
    } else if (pid > 0) {
        wait(NULL);
        printf("Message received: %s\n", data);
    } else {
        perror("fork");
    }

    shmdt(data);
    shmctl(id, IPC_RMID, NULL);

    return 0;
}
