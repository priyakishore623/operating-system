
#include <stdio.h>

int main() {
    int n, i, j, time = 0, completed = 0, idx, temp;
    int at[10], bt[10], wt[10], tat[10], done[10] = {0};

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter arrival time and burst time for P%d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
    }

    while (completed < n) {
        idx = -1;

        for (i = 0; i < n; i++) {
            if (!done[i] && at[i] <= time &&
                (idx == -1 || bt[i] < bt[idx]))
                idx = i;
        }

        if (idx == -1) {
            time++;
            continue;
        }

        time += bt[idx];
        tat[idx] = time - at[idx];
        wt[idx] = tat[idx] - bt[idx];
        done[idx] = 1;
        completed++;
    }

    printf("\nProcess\tAT\tBT\tWT\tTAT\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], wt[i], tat[i]);

    return 0;
}
