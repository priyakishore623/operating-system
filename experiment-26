#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    FILE *file;
    char data[100];
    char filename[50];

    printf("Enter file name: ");
    scanf("%s", filename);

    /* Create and write to file */
    file = fopen(filename, "w");

    if (file == NULL)
    {
        printf("Error creating file.\n");
        return 1;
    }

    printf("Enter data to write into the file: ");
    scanf(" %[^\n]", data);

    fprintf(file, "%s", data);

    fclose(file);

    printf("\nFile created and data written successfully.\n");

    /* Read from file */
    file = fopen(filename, "r");

    if (file == NULL)
    {
        printf("Error opening file.\n");
        return 1;
    }

    printf("\nData in the file:\n");

    while (fgets(data, sizeof(data), file) != NULL)
    {
        printf("%s\n", data);
    }

    fclose(file);

    /* Append data */
    file = fopen(filename, "a");

    if (file == NULL)
    {
        printf("Error opening file for append.\n");
        return 1;
    }

    printf("\nEnter data to append: ");
    scanf(" %[^\n]", data);

    fprintf(file, "\n%s", data);

    fclose(file);

    printf("Data appended successfully.\n");

    /* Display updated file */
    file = fopen(filename, "r");

    if (file == NULL)
    {
        printf("Error opening file.\n");
        return 1;
    }

    printf("\nUpdated file contents:\n");

    while (fgets(data, sizeof(data), file) != NULL)
    {
        printf("%s\n", data);
    }

    fclose(file);

    printf("\nFile closed successfully.\n");

    return 0;
}
