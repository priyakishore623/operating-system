
#include <stdio.h>

int main() {
    int n, i, time = 0, quantum, completed = 0;
    int at[10], bt[10], rt[10], wt[10], tat[10];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter arrival time and burst time for P%d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
        rt[i] = bt[i];
    }

    printf("Enter time quantum: ");
    scanf("%d", &quantum);

    if (quantum <= 0 || n < 1 || n > 10)
        return 1;

    int queue[1000], front = 0, rear = 0;
    int inqueue[10] = {0};

    while (completed < n) {
        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0 && !inqueue[i]) {
                queue[rear++] = i;
                inqueue[i] = 1;
            }
        }

        if (front == rear) {
            time++;
            continue;
        }

        int p = queue[front++];
        int run = rt[p] < quantum ? rt[p] : quantum;
        time += run;
        rt[p] -= run;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0 && !inqueue[i]) {
                queue[rear++] = i;
                inqueue[i] = 1;
            }
        }

        if (rt[p] > 0) {
            queue[rear++] = p;
        } else {
            tat[p] = time - at[p];
            wt[p] = tat[p] - bt[p];
            completed++;
        }

        inqueue[p] = 0;
    }

    printf("\nProcess\tAT\tBT\tWT\tTAT\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], wt[i], tat[i]);

    return 0;
}
