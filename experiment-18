#include <stdio.h>

#define SIZE 5

int buffer[SIZE];
int in = 0;
int out = 0;

int empty = SIZE;
int full = 0;
int mutex = 1;

void wait(int *semaphore)
{
    while (*semaphore <= 0)
    {
        /* Wait */
    }

    (*semaphore)--;
}

void signal(int *semaphore)
{
    (*semaphore)++;
}

void produce()
{
    int item;

    if (empty == 0)
    {
        printf("Buffer is full. Producer cannot produce.\n");
        return;
    }

    printf("Enter item to produce: ");
    scanf("%d", &item);

    wait(&empty);
    wait(&mutex);

    buffer[in] = item;
    printf("Produced item: %d\n", item);

    in = (in + 1) % SIZE;

    signal(&mutex);
    signal(&full);
}

void consume()
{
    int item;

    if (full == 0)
    {
        printf("Buffer is empty. Consumer cannot consume.\n");
        return;
    }

    wait(&full);
    wait(&mutex);

    item = buffer[out];
    printf("Consumed item: %d\n", item);

    out = (out + 1) % SIZE;

    signal(&mutex);
    signal(&empty);
}

void display()
{
    int i;

    if (full == 0)
    {
        printf("Buffer is empty.\n");
        return;
    }

    printf("Buffer contents:\n");

    for (i = 0; i < SIZE; i++)
    {
        printf("%d ", buffer[i]);
    }

    printf("\n");
}

int main()
{
    int choice;

    while (1)
    {
        printf("\n--- PRODUCER CONSUMER PROBLEM ---\n");
        printf("1. Produce\n");
        printf("2. Consume\n");
        printf("3. Display Buffer\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                produce();
                break;

            case 2:
                consume();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting...\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
