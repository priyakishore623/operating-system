#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
#include <string.h>

int main()
{
    int fd;
    char data[] = "UNIX System Calls";
    char buffer[100];
    struct stat fileInfo;
    DIR *dir;
    struct dirent *entry;
    int flags;

    /* ---------------- OPEN ---------------- */
    fd = open("sample.txt", O_CREAT | O_RDWR, 0644);

    if (fd == -1)
    {
        printf("Error opening file.\n");
        return 1;
    }

    printf("File opened successfully.\n");

    /* Write data */
    write(fd, data, strlen(data));
    printf("Data written successfully.\n");

    /* ---------------- SEEK ---------------- */
    lseek(fd, 0, SEEK_SET);

    read(fd, buffer, strlen(data));
    buffer[strlen(data)] = '\0';

    printf("Data after seek: %s\n", buffer);

    /* ---------------- FCNTL ---------------- */
    flags = fcntl(fd, F_GETFL);

    if (flags != -1)
    {
        printf("fcntl(): File status flags obtained successfully.\n");
    }
    else
    {
        printf("fcntl() failed.\n");
    }

    /* ---------------- STAT ---------------- */
    if (stat("sample.txt", &fileInfo) == 0)
    {
        printf("\nFile Information:\n");
        printf("File size: %ld bytes\n", fileInfo.st_size);
        printf("File inode number: %ld\n", fileInfo.st_ino);
    }
    else
    {
        printf("stat() failed.\n");
    }

    /* ---------------- OPENDIR ---------------- */
    dir = opendir(".");

    if (dir == NULL)
    {
        printf("Unable to open directory.\n");
        close(fd);
        return 1;
    }

    printf("\nFiles in current directory:\n");

    /* ---------------- READDIR ---------------- */
    while ((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    /* ---------------- CLOSE ---------------- */
    close(fd);

    printf("\nFile closed successfully.\n");

    return 0;
}
